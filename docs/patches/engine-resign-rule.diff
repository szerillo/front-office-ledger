+def _resign_skip(evs):
+    """v6.0: a release or free-agent filing followed within 60 days by a minor-league re-sign with the club that
+    held him is a roster move, not the end of his window (Eli White, released and re-signed by Atlanta in July
+    2023; Nov 11 audit). Returns the indexes of both events. Events without the signing club (old 3-field rows)
+    are never skipped."""
+    skip = set()
+    for k, e in enumerate(evs):
+        if e[1] not in ("Released", "Declared Free Agency"): continue
+        for j in range(k + 1, len(evs)):
+            f = evs[j]
+            if f[1] != "Signed as Free Agent": continue
+            if len(f) >= 5 and f[4] and f[3] and f[3] == e[2] and (_date.fromisoformat(f[0][:10]) - _date.fromisoformat(e[0][:10])).days <= 60:
+                skip.update((k, j))
+            break
+    return skip
